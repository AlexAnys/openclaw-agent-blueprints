{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.dev/schema/manifest.schema.json",
  "title": "OpenClaw Blueprint Manifest",
  "description": "Schema for the top-level manifest that indexes all available blueprints and team compositions.",
  "type": "object",
  "required": ["version", "generated", "methodology_version", "blueprints", "teams"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Manifest schema version."
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime when this manifest was generated."
    },
    "methodology_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the blueprint methodology this manifest follows."
    },
    "blueprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "when_to_use",
          "complexity",
          "tags",
          "params",
          "requires_skills",
          "requires_tools",
          "team_compatible",
          "quality_tier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+/[a-z-]+$"
          },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "engineering",
              "design",
              "marketing",
              "sales",
              "product",
              "project-management",
              "testing",
              "support",
              "spatial-computing",
              "paid-media",
              "specialized",
              "china-market"
            ]
          },
          "description": { "type": "string" },
          "when_to_use": { "type": "string" },
          "complexity": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Estimated complexity of tasks this agent handles."
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "params": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of parameter names this blueprint accepts."
          },
          "requires_skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "requires_tools": {
            "type": "array",
            "items": { "type": "string" }
          },
          "team_compatible": {
            "type": "boolean",
            "description": "Whether this blueprint can participate in multi-agent teams."
          },
          "quality_tier": {
            "type": "string",
            "enum": ["experimental", "community", "curated", "verified"],
            "description": "Quality and review status of this blueprint."
          }
        },
        "additionalProperties": false
      },
      "description": "Summary entries for all registered blueprints."
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "agents", "when_to_use", "coordination"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z-]+/[a-z-]+$"
            },
            "minItems": 2,
            "description": "Blueprint IDs of agents in this team."
          },
          "when_to_use": { "type": "string" },
          "coordination": {
            "type": "string",
            "enum": ["sequential", "parallel", "hierarchical", "collaborative"],
            "description": "How agents in this team coordinate work."
          }
        },
        "additionalProperties": false
      },
      "description": "Pre-defined team compositions."
    }
  },
  "additionalProperties": false
}
